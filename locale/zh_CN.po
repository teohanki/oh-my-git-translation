msgstr "远程仓库"

msgid "Changing the past"
msgstr "改变过去"

msgid "Fixing mistakes"
msgstr "修正错误"

msgid "Workflows"
msgstr "工作流程"

msgid "Bisect"
msgstr "二分查找"

